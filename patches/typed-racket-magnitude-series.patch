+++ b/typed-racket-lib/typed-racket/optimizer/float-complex.rkt
@@ -446,28 +446,7 @@
           [(#%plain-app op:magnitude^ c:unboxed-float-complex-opt-expr)
            (log-unboxing-opt "unboxed unary float complex")
            #`(let*-values (c.bindings ...)
-               ;; Squaring is safe in this range; outside it, scale before
-               ;; squaring to avoid overflow and underflow.
-               (let*-values ([(r) (unsafe-flabs c.real-binding)]
-                             [(i) (unsafe-flabs c.imag-binding)]
-                             [(larger) (if (unsafe-fl< r i) i r)])
-                 (cond
-                   [(or (unsafe-fl= r +inf.0) (unsafe-fl= i +inf.0)) +inf.0]
-                   [(and (unsafe-fl>= larger 1e-150)
-                         (unsafe-fl<= larger 1e150))
-                    (unsafe-flsqrt (unsafe-fl+ (unsafe-fl* r r)
-                                               (unsafe-fl* i i)))]
-                   [(unsafe-fl= i 0.0) r]
-                   [(unsafe-fl< i r)
-                    (let-values ([(q) (unsafe-fl/ i r)])
-                      (unsafe-fl* r
-                                  (unsafe-flsqrt (unsafe-fl+ 1.0
-                                                             (unsafe-fl* q q)))))]
-                   [else
-                    (let-values ([(q) (unsafe-fl/ r i)])
-                      (unsafe-fl* i
-                                  (unsafe-flsqrt (unsafe-fl+ 1.0
-                                                             (unsafe-fl* q q)))))])))])))
+               (unsafe-flhypot c.real-binding c.imag-binding))])))
 
 
   (pattern (#%plain-app op:float-complex-op e:expr ...)
diff --git a/typed-racket-lib/typed-racket/optimizer/float.rkt b/typed-racket-lib/typed-racket/optimizer/float.rkt
index 38c9fcb6..509c373f 100644
--- a/typed-racket-lib/typed-racket/optimizer/float.rkt
+++ b/typed-racket-lib/typed-racket/optimizer/float.rkt
@@ -26,7 +26,9 @@
   (mk-unsafe-tbl generic "fl~a" "unsafe-fl~a"))
 
 (define binary-float-ops
-  (mk-float-tbl (list #'+ #'- #'* #'/ #'min #'max #'expt)))
+  (free-id-table-set
+   (mk-float-tbl (list #'+ #'- #'* #'/ #'min #'max #'expt))
+   #'flhypot #'unsafe-flhypot))
 (define binary-float-comps
   (free-id-table-set*
     (mk-float-tbl (list #'= #'<= #'< #'> #'>=))
@@ -334,4 +336,3 @@
      #:do [(log-opt-info "possible exact real arith")]
      #:with opt (syntax/loc this-syntax (op n.opt ...)))
   )
