From 8c8af219846456a08255b303217ee343f8736fb7 Mon Sep 17 00:00:00 2001
From: Sam Tobin-Hochstadt <samth@iu.edu>
Date: Tue, 15 Sep 2026 17:19:00 -0400
Subject: [PATCH 1/3] Avoid generic zero? in float-complex magnitude
 optimization

---
 typed-racket-lib/typed-racket/optimizer/float-complex.rkt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/typed-racket-lib/typed-racket/optimizer/float-complex.rkt b/typed-racket-lib/typed-racket/optimizer/float-complex.rkt
index b5a2b99b..83b2080b 100644
--- a/typed-racket-lib/typed-racket/optimizer/float-complex.rkt
+++ b/typed-racket-lib/typed-racket/optimizer/float-complex.rkt
@@ -449,7 +449,7 @@
                ;; reuses the algorithm used by the Racket runtime
                (let*-values ([(r) (unsafe-flabs c.real-binding)]
                              [(i) (unsafe-flabs c.imag-binding)])
-                 (if (zero? i)
+                 (if (unsafe-fl= i 0.0)
                      r
                      (if (or (unsafe-fl= r +inf.0)(unsafe-fl= i +inf.0))
                          +inf.0
-- 
2.53.0


From 5bc1455f4602d686a01d4f358f61c366643ea070 Mon Sep 17 00:00:00 2001
From: Sam Tobin-Hochstadt <samth@iu.edu>
Date: Tue, 15 Sep 2026 17:26:27 -0400
Subject: [PATCH 2/3] Use direct squaring for ordinary float-complex magnitudes

---
 .../typed-racket/optimizer/float-complex.rkt  | 36 +++++++++++--------
 .../succeed/magnitude-scaled.rkt              |  9 +++++
 2 files changed, 30 insertions(+), 15 deletions(-)
 create mode 100644 typed-racket-test/succeed/magnitude-scaled.rkt

diff --git a/typed-racket-lib/typed-racket/optimizer/float-complex.rkt b/typed-racket-lib/typed-racket/optimizer/float-complex.rkt
index 83b2080b..cbf3b2a9 100644
--- a/typed-racket-lib/typed-racket/optimizer/float-complex.rkt
+++ b/typed-racket-lib/typed-racket/optimizer/float-complex.rkt
@@ -446,22 +446,28 @@
           [(#%plain-app op:magnitude^ c:unboxed-float-complex-opt-expr)
            (log-unboxing-opt "unboxed unary float complex")
            #`(let*-values (c.bindings ...)
-               ;; reuses the algorithm used by the Racket runtime
+               ;; Squaring is safe in this range; outside it, scale before
+               ;; squaring to avoid overflow and underflow.
                (let*-values ([(r) (unsafe-flabs c.real-binding)]
-                             [(i) (unsafe-flabs c.imag-binding)])
-                 (if (unsafe-fl= i 0.0)
-                     r
-                     (if (or (unsafe-fl= r +inf.0)(unsafe-fl= i +inf.0))
-                         +inf.0
-                         (if (unsafe-fl< i r)
-                             (let-values ([(q) (unsafe-fl/ i r)])
-                               (unsafe-fl* r
-                                           (unsafe-flsqrt (unsafe-fl+ 1.0
-                                                                      (unsafe-fl* q q)))))
-                             (let-values ([(q) (unsafe-fl/ r i)])
-                               (unsafe-fl* i
-                                           (unsafe-flsqrt (unsafe-fl+ 1.0
-                                                                      (unsafe-fl* q q))))))))))])))
+                             [(i) (unsafe-flabs c.imag-binding)]
+                             [(larger) (if (unsafe-fl< r i) i r)])
+                 (cond
+                   [(or (unsafe-fl= r +inf.0) (unsafe-fl= i +inf.0)) +inf.0]
+                   [(and (unsafe-fl>= larger 1e-150)
+                         (unsafe-fl<= larger 1e150))
+                    (unsafe-flsqrt (unsafe-fl+ (unsafe-fl* r r)
+                                               (unsafe-fl* i i)))]
+                   [(unsafe-fl= i 0.0) r]
+                   [(unsafe-fl< i r)
+                    (let-values ([(q) (unsafe-fl/ i r)])
+                      (unsafe-fl* r
+                                  (unsafe-flsqrt (unsafe-fl+ 1.0
+                                                             (unsafe-fl* q q)))))]
+                   [else
+                    (let-values ([(q) (unsafe-fl/ r i)])
+                      (unsafe-fl* i
+                                  (unsafe-flsqrt (unsafe-fl+ 1.0
+                                                             (unsafe-fl* q q)))))])))])))
 
 
   (pattern (#%plain-app op:float-complex-op e:expr ...)
diff --git a/typed-racket-test/succeed/magnitude-scaled.rkt b/typed-racket-test/succeed/magnitude-scaled.rkt
new file mode 100644
index 00000000..fbd03620
--- /dev/null
+++ b/typed-racket-test/succeed/magnitude-scaled.rkt
@@ -0,0 +1,9 @@
+#lang typed/racket/base
+
+(require typed/rackunit)
+
+;; Ordinary values use direct squaring; extreme values need the scaled path.
+(check-equal? (magnitude 3.0+4.0i) 5.0)
+(check-equal? (magnitude 3e-200+4e-200i) 5e-200)
+(check-= (magnitude 3e200+4e200i) 5e200 1e186)
+(check-equal? (magnitude 1e308+1e308i) 1.4142135623730951e308)
-- 
2.53.0


From 1819ebdafdb15a058068f800ca8ec7b10c375ffc Mon Sep 17 00:00:00 2001
From: Sam Tobin-Hochstadt <samth@iu.edu>
Date: Wed, 16 Sep 2026 00:39:05 -0400
Subject: [PATCH 3/3] Use flhypot for float-complex magnitude

---
