From 3fd5a82ae33af7f21aed688027ffff83be120704 Mon Sep 17 00:00:00 2001
From: Sam Tobin-Hochstadt <samth@iu.edu>
Date: Wed, 16 Sep 2026 00:39:05 -0400
Subject: [PATCH] Use racket/flonum's flhypot

---
 math-lib/math/private/flonum/flonum-functions.rkt | 14 +-------------
 math-test/math/tests/function-tests.rkt           |  4 ++--
 2 files changed, 3 insertions(+), 15 deletions(-)

diff --git a/math-lib/math/private/flonum/flonum-functions.rkt b/math-lib/math/private/flonum/flonum-functions.rkt
index d36a7ab..0311f31 100644
--- a/math-lib/math/private/flonum/flonum-functions.rkt
+++ b/math-lib/math/private/flonum/flonum-functions.rkt
@@ -12,7 +12,7 @@
          flsubnormal? flrational? flinfinite? flnan? flinteger?
          flnext* flprev*
          flulp-error
-         fleven? flodd? flsgn flhypot fllog/base
+         fleven? flodd? flsgn fllog/base
          flprobability?
          flsinpix flcospix fltanpix flcscpix flsecpix flcotpix)
 
@@ -126,18 +126,6 @@
            (let ([0.5x  (fl* 0.5 (fl+ 1.0 x))])
              (fl= (truncate 0.5x) 0.5x)))))
   
-  (: flhypot (Flonum Flonum -> Flonum))
-  (define (flhypot x y)
-    (define xa (flabs x))
-    (define ya (flabs y))
-    (let ([xa  (flmin xa ya)]
-          [ya  (flmax xa ya)])
-      (cond [(fl= xa 0.0)  ya]
-            [(flrational? ya)
-             (define u (fl/ xa ya))
-             (fl* ya (flsqrt (fl+ 1.0 (fl* u u))))]
-            [else ya])))
-  
   ;; todo: overflow not likely; underflow likely
   (: fllog/base (Flonum Flonum -> Flonum))
   (define (fllog/base b x)
diff --git a/math-test/math/tests/function-tests.rkt b/math-test/math/tests/function-tests.rkt
index a593966..4ed6b9d 100644
--- a/math-test/math/tests/function-tests.rkt
+++ b/math-test/math/tests/function-tests.rkt
@@ -62,7 +62,7 @@
 (check-equal? (flhypot +inf.0 -inf.0) +inf.0)
 (check-equal? (flhypot 1. -inf.0) +inf.0)
 (check-equal? (flhypot +inf.0 1.) +inf.0)
-(check-equal? (flhypot +inf.0 +nan.0) +nan.0)
+(check-equal? (flhypot +inf.0 +nan.0) +inf.0)
   
 ;; ---------------------------------------------------------------------------------------------------
 ;; logs, exponents, bases, etc.
@@ -110,4 +110,4 @@
 (check-= (fllog-quotient 500000000001. +500000000000.) 2e-12 1e-20)
 (check-= (fllog-hypot #i3/5 #i4/5) 2.22e-17 1e-18)
 (check-= (fllog-hypot +min.0 +min.0) -744.0934983311013 1e-10)
-(check-= (fllog-hypot +max.0 +max.0) 710.1292864836639 1e-10)
\ No newline at end of file
+(check-= (fllog-hypot +max.0 +max.0) 710.1292864836639 1e-10)
-- 
2.53.0

